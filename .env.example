# ==========================================
# DATABASE — MongoDB Atlas
# ==========================================
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/blog-cms?retryWrites=true&w=majority"

# ==========================================
# AUTH.JS (NextAuth v5)
# ==========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==========================================
# CLOUDINARY — image uploads / media library
# ==========================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="blog_cms_unsigned"

# ==========================================
# RESEND — transactional email & newsletter
# ==========================================
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Blog CMS <newsletter@yourdomain.com>"

# ==========================================
# SITE
# ==========================================
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_NAME="Your Blog"

# ==========================================
# ANALYTICS
# ==========================================
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_CLARITY_ID=""
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# ==========================================
# ADSENSE
# ==========================================
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"
NEXT_PUBLIC_ADS_ENABLED="false"

# ==========================================
# RATE LIMITING — Upstash Redis (optional but recommended)
# ==========================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==========================================
# MISC
# ==========================================
REVALIDATE_SECRET="replace-with-a-random-secret"
